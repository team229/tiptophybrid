---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPage, type PageData } from '../data/pages';
import { SITE } from '../data/site';

const HOME = getPage('home')!;
const PATH = '/thank-you/';
const URL = `${SITE.origin}${PATH}`;

const page: PageData = {
  ...HOME,
  slug: 'thank-you',
  url: URL,
  path: PATH,
  seo: {
    ...HOME.seo,
    title: 'Thanks — we have your request | Tip Top Hybrid',
    description:
      'Your request has been received. A Tip Top Hybrid specialist will call you back shortly.',
    robots: 'noindex, nofollow',
    ogTitle: 'Thanks — we have your request | Tip Top Hybrid',
    ogDescription: 'A Tip Top Hybrid specialist will call you back shortly.',
    ogUrl: URL,
    canonical: URL,
    next: '',
    prev: '',
  },
};
---

<BaseLayout page={page} variant="landing">
  <section class="bg-[#f3f7f9] py-14 sm:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6">
      <div class="boxshadow rounded-md bg-white p-7 text-center sm:p-12">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-8 w-8 text-green-600"
            aria-hidden="true"
          >
            <path d="M20 6 9 17l-5-5"></path>
          </svg>
        </div>

        <h1 class="mt-6 text-3xl font-bold text-[#272727] sm:text-4xl">Thanks — we’ve got it.</h1>

        <p class="mt-4 text-[15px] leading-relaxed text-[#6b7280] sm:text-base">
          Your request is with our team. A hybrid specialist will call you back shortly — usually
          within one business hour while the shop is open.
        </p>

        <a
          href={`tel:${SITE.phoneRaw}`}
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-md bg-green-500 px-7 py-3.5 text-base font-semibold text-white shadow-md transition-colors hover:bg-green-600 hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="h-5 w-5"
            aria-hidden="true"
          >
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Call {SITE.phone}
        </a>

        <p class="mt-4 text-sm text-[#6b7280]">Need us right now? Calling is the fastest way.</p>

        <div class="mt-8 border-t border-gray-100 pt-6 text-sm text-[#6b7280]">
          <p class="font-medium text-[#272727]">{SITE.street}, Upland, CA 91786</p>
          <p class="mt-1">Monday – Saturday · 9:00 am – 5:00 pm · Closed Sunday</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
