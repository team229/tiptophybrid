---
import type { ServicePageData } from '../data/services';
import { SITE } from '../data/site';

interface Props {
  service: ServicePageData;
}
const { service } = Astro.props;
const tel = SITE.phone;
const telHref = `tel:${SITE.phoneRaw}`;

const url = `https://www.tiptophybrid.com${Astro.url.pathname}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${url}#service`,
      name: service.h1,
      serviceType: service.eyebrow,
      description: service.metaDescription,
      url,
      provider: {
        '@type': 'AutoRepair',
        '@id': 'https://www.tiptophybrid.com/#organization',
        name: 'Tip Top Hybrid',
        telephone: '+1-909-238-7028',
        address: {
          '@type': 'PostalAddress',
          streetAddress: '1894 W 9th St Ste B',
          addressLocality: 'Upland',
          addressRegion: 'CA',
          postalCode: '91786',
          addressCountry: 'US',
        },
      },
      areaServed: ['Upland', 'Montclair', 'Claremont', 'Pomona', 'Rancho Cucamonga', 'Ontario', 'San Bernardino', 'Riverside'].map((name) => ({ '@type': 'City', name })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: service.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tiptophybrid.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://www.tiptophybrid.com/upland-auto-body-car-repair-shop-services/' },
        { '@type': 'ListItem', position: 3, name: service.eyebrow },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="service-page">
  <!-- Breadcrumb -->
  <nav class="mx-auto max-w-6xl px-5 pt-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-green-700" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a class="hover:text-green-700" href="/upland-auto-body-car-repair-shop-services/">Services</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-700">{service.eyebrow}</li>
    </ol>
  </nav>

  <!-- Hero -->
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-center lg:py-14">
    <div>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-green-700">{service.eyebrow}</p>
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.7rem]">
        {service.h1}
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-700">{service.answer}</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href={telHref} class="rounded-lg bg-green-600 px-6 py-3 font-bold text-white shadow-sm transition hover:bg-green-700">
          Call {tel}
        </a>
        <a href="/free-estimate/" class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-800 transition hover:border-green-600 hover:text-green-700">
          Get a free estimate
        </a>
      </div>
      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600">
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Hybrid-only diagnostics</li>
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Written quote first</li>
        <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Upland, CA</li>
      </ul>
    </div>
    <div>
      <img
        src={service.image}
        alt={service.imageAlt}
        width="900"
        height="600"
        loading="eager"
        class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lg"
      />
    </div>
  </section>

  <!-- Intro -->
  <section class="border-y border-slate-100 bg-white">
    <div class="mx-auto max-w-3xl px-5 py-12">
      {service.intro.map((p) => <p class="mb-5 text-[1.06rem] leading-[1.8] text-slate-700 last:mb-0">{p}</p>)}
    </div>
  </section>

  <!-- Symptoms -->
  <section class="mx-auto max-w-6xl px-5 py-14">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.symptomsTitle}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {service.symptoms.map((s) => (
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="mb-2 font-bold text-slate-900">{s.title}</h3>
          <p class="text-sm leading-relaxed text-slate-600">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Included + table -->
  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.includedTitle}</h2>
        <ul class="mt-6 space-y-3">
          {service.included.map((item) => (
            <li class="flex gap-3 text-[1.02rem] leading-relaxed text-slate-700">
              <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">✓</span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      {service.table && (
        <div class="lg:col-span-2">
          <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.table.title}</h2>
          {service.table.note && <p class="mt-2 text-sm text-slate-500">{service.table.note}</p>}
          <div class="mt-6 overflow-x-auto rounded-xl border border-slate-200">
            <table class="w-full min-w-[560px] border-collapse text-left text-sm">
              <thead class="bg-slate-50">
                <tr>
                  {service.table.headers.map((h) => <th class="border-b border-slate-200 px-4 py-3 font-bold text-slate-900">{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {service.table.rows.map((r, i) => (
                  <tr class={i % 2 ? 'bg-slate-50/50' : ''}>
                    {r.cells.map((c, j) => (
                      <td class={`border-b border-slate-100 px-4 py-3 align-top ${j === 0 ? 'font-semibold text-slate-800' : 'text-slate-600'}`}>{c}</td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Pricing -->
  <section class="mx-auto max-w-6xl px-5 py-14">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.pricingTitle}</h2>
    <p class="mt-2 max-w-3xl text-sm text-slate-500">{service.pricingNote}</p>
    <div class="mt-8 overflow-x-auto rounded-xl border border-slate-200 bg-white">
      <table class="w-full min-w-[560px] border-collapse text-left text-sm">
        <thead class="bg-slate-50">
          <tr>
            <th class="border-b border-slate-200 px-4 py-3 font-bold text-slate-900">Service</th>
            <th class="border-b border-slate-200 px-4 py-3 font-bold text-slate-900">Typical range</th>
            <th class="border-b border-slate-200 px-4 py-3 font-bold text-slate-900">What it covers</th>
          </tr>
        </thead>
        <tbody>
          {service.pricing.map((r, i) => (
            <tr class={i % 2 ? 'bg-slate-50/50' : ''}>
              <td class="border-b border-slate-100 px-4 py-3 font-semibold text-slate-800">{r.item}</td>
              <td class="whitespace-nowrap border-b border-slate-100 px-4 py-3 font-semibold text-green-700">{r.range}</td>
              <td class="border-b border-slate-100 px-4 py-3 text-slate-600">{r.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-slate-900 text-white">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">{service.processTitle}</h2>
      <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {service.process.map((p, i) => (
          <li class="rounded-xl bg-white/5 p-5 ring-1 ring-white/10">
            <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-full bg-green-500 font-bold text-slate-900">{i + 1}</span>
            <h3 class="mb-2 font-bold text-white">{p.title}</h3>
            <p class="text-sm leading-relaxed text-slate-300">{p.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Models + local -->
  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-2">
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.modelsTitle}</h2>
      <ul class="mt-6 flex flex-wrap gap-2">
        {service.models.map((m) => (
          <li class="rounded-full border border-slate-200 bg-white px-3.5 py-1.5 text-sm text-slate-700">{m}</li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">{service.localTitle}</h2>
      {service.local.map((p) => <p class="mt-4 text-[1.02rem] leading-[1.8] text-slate-700">{p}</p>)}
      <p class="mt-5 text-sm text-slate-500">
        Tip Top Hybrid · 1894 W 9th St Ste B, Upland, CA 91786 · <a class="font-semibold text-green-700" href={telHref}>{tel}</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-slate-100 bg-white">
    <div class="mx-auto max-w-3xl px-5 py-14">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Frequently asked questions</h2>
      <div class="mt-7 divide-y divide-slate-200">
        {service.faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-slate-900">
              <span>{f.q}</span>
              <span class="mt-1 flex-none text-green-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[1.02rem] leading-[1.8] text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="mx-auto max-w-6xl px-5 pb-14">
    <h2 class="text-xl font-extrabold tracking-tight text-slate-900">Related reading</h2>
    <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {service.related.map((r) => (
        <li>
          <a class="block rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-green-800 transition hover:border-green-500 hover:bg-green-50" href={r.href}>
            {r.label} →
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- CTA -->
  <section class="bg-green-700">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Get a straight answer before you spend</h2>
        <p class="mt-2 max-w-2xl text-green-50">
          Tell us the year, model and what the car is doing. We will tell you what it likely needs, what it costs and whether it can wait.
        </p>
      </div>
      <div class="flex flex-none flex-wrap gap-3">
        <a href={telHref} class="rounded-lg bg-white px-6 py-3 font-bold text-green-800 shadow-sm transition hover:bg-green-50">Call {tel}</a>
        <a href="/free-estimate/" class="rounded-lg border border-white/60 px-6 py-3 font-semibold text-white transition hover:bg-white/10">Free estimate</a>
      </div>
    </div>
  </section>
</div>
