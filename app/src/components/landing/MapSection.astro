---
import { SITE } from '../../data/site';
---

<section aria-label="Shop location map">
  <iframe
    src={SITE.mapIframeNoCard}
    title="Tip Top Hybrid location map"
    width="100%"
    height="300"
    class="block h-[240px] w-full sm:h-[300px]"
    style="border:0; display:block;"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    allowfullscreen
  ></iframe>
</section>
