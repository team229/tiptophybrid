---
import { getContactSection } from '../../data/landing';
import { SITE } from '../../data/site';

const contact = getContactSection();
---

<!-- The home page's contact section, markup untouched, so the form is identical. -->
<Fragment set:html={contact} />

<style is:global>
  .repair-form-error {
    margin-bottom: 1em;
    border: 1px solid #fecaca;
    border-radius: 4px;
    background: #fef2f2;
    padding: 0.75em 1em;
    color: #b91c1c;
    font-size: 0.95em;
  }
</style>

<script
  define:vars={{ phone: SITE.phone, phoneRaw: SITE.phoneRaw }}
>
  (() => {
    /** Lead routing for the landing page — same fields, different destination. */
    const ENDPOINT = 'https://api-inform.bythub.in/?formId=zBThbXUhFQkJWhNIgEkV';

    const form = document.getElementById('gform_1');
    if (!form) return;

    const wrapper = form.closest('.gform_wrapper') || form;
    const button = form.querySelector('input[type="submit"]');
    let errorEl = null;

    const showError = (message) => {
      if (!errorEl) {
        errorEl = document.createElement('p');
        errorEl.className = 'repair-form-error';
        errorEl.setAttribute('role', 'alert');
        form.prepend(errorEl);
      }
      errorEl.textContent = message;
      errorEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.remove();

      const data = new FormData(form);
      const value = (key) => (data.get(key) || '').toString().trim();

      const name = value('input_1');
      const email = value('input_2');
      const phoneField = value('input_3');
      const year = value('input_6');
      const make = value('input_4');
      const model = value('input_7');
      const issues = value('input_8');

      if (!name) return showError('Please enter your name.');
      if (!email && !phoneField) {
        return showError('Please add an email or a phone number so we can reach you.');
      }

      const vehicle = [year, make, model].filter(Boolean).join(' ');
      const payload = {
        name,
        email,
        phone: phoneField,
        // The notification email is built from `message`, so include everything.
        message: [
          phoneField && 'Phone: ' + phoneField,
          vehicle && 'Vehicle: ' + vehicle,
          issues && 'Issues: ' + issues,
          'Page: ' + window.location.href,
        ]
          .filter(Boolean)
          .join('\n'),
      };

      const originalLabel = button ? button.value : '';
      if (button) {
        button.disabled = true;
        button.value = 'Sending…';
      }

      try {
        const response = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error('HTTP ' + response.status);

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'generate_lead', form: 'repair_landing' });

        const confirmation = document.createElement('div');
        confirmation.className = 'gform_confirmation_message';
        confirmation.setAttribute('role', 'status');
        confirmation.innerHTML =
          '<strong>Thanks — your request is in.</strong><br>We’ll be in touch shortly. ' +
          'Need us now? Call <a href="tel:' + phoneRaw + '">' + phone + '</a>.';
        wrapper.replaceChildren(confirmation);
      } catch (err) {
        if (button) {
          button.disabled = false;
          button.value = originalLabel;
        }
        showError('Sorry, something went wrong. Please call us on ' + phone + ' and we’ll take your details.');
      }
    });
  })();
</script>
