---
import { SITE } from '../../data/site';

/**
 * Address + opening hours. Styled with the home page's own tokens: #272727
 * headings, #999999 body copy, the green `.textgradient` accent, white
 * `.boxshadow` cards and the light #f3f7f9 band the site uses for sections.
 */
const HOURS = [
  { day: 'Monday – Saturday', time: '9:00 am – 5:00 pm' },
  { day: 'Sunday', time: 'Closed' },
];
---

<section class="bg-[#f3f7f9] py-12 sm:py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="boxshadow bg-white p-7 sm:p-9">
        <h2 class="text-2xl font-bold text-[#272727]">
          <span class="textgradient">Visit</span> the shop
        </h2>

        <ul class="mt-6 space-y-5 text-[15px] leading-relaxed text-[#6b7280]">
          <li class="flex gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 h-5 w-5 shrink-0 text-[#39b54a]"
              aria-hidden="true"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <span class="text-[#272727]">
              {SITE.street}<br />Upland, CA 91786
            </span>
          </li>

          <li class="flex gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 h-5 w-5 shrink-0 text-[#39b54a]"
              aria-hidden="true"
            >
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span class="text-[#272727]">{SITE.phone}</span>
          </li>

          <li class="flex gap-3">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mt-0.5 h-5 w-5 shrink-0 text-[#39b54a]"
              aria-hidden="true"
            >
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.99 5.73a2 2 0 0 1-2.02 0L2 7"></path>
            </svg>
            <span class="text-[#272727]">{SITE.email}</span>
          </li>
        </ul>
      </div>

      <div class="boxshadow bg-white p-7 sm:p-9">
        <h2 class="text-2xl font-bold text-[#272727]">
          <span class="textgradient">Opening</span> hours
        </h2>

        <dl class="mt-6 text-[15px] text-[#6b7280]">
          {
            HOURS.map((h) => (
              <div class="flex items-baseline justify-between gap-6 border-b border-gray-100 py-3 last:border-0">
                <dt class="font-medium text-[#272727]">{h.day}</dt>
                <dd>{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
