---
import { SITE } from '../../data/site';

/**
 * Minimal landing footer — the address/hours now live above the map, so this is
 * just the copyright line, on the same dark band + green top border as the site
 * footer. No links.
 */
---

<footer class="border-t-4 border-green-500 bg-[#1f2937] py-8 text-white">
  <div class="mx-auto max-w-6xl px-4 text-center sm:px-6 lg:px-8">
    <img src={SITE.logo} alt="Tip Top Hybrid" class="mx-auto h-9 w-auto sm:h-10" />
    <p class="mt-4 text-xs text-white/60">© 2026 Tip Top Hybrid. All Rights Reserved.</p>
    <p class="mt-1.5 text-[11px] text-white/40">
      Toyota Prius &amp; hybrid repair · Upland, CA
    </p>
  </div>
</footer>
