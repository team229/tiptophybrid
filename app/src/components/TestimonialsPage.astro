---
import { SITE } from '../data/site';

const tel = SITE.phone;
const telHref = `tel:${SITE.phoneRaw}`;


const reviews = [
  {
    quote:
      'My 2010 Prius started losing power, and the dealership said I needed a new battery for $4,200. Tip Top Hybrid replaced it with a reconditioned pack and got me back on the road the same day — for less than half the price.',
    name: 'Angela R.',
    city: 'Upland, CA',
    service: 'Hybrid battery replacement',
  },
  {
    quote:
      'I have owned three Priuses over the years, and Tip Top Hybrid is the only place I take them now. They caught an inverter issue early that could have cost me thousands. Super knowledgeable and honest.',
    name: 'Derrick S.',
    city: 'Montclair, CA',
    service: 'Inverter diagnosis',
  },
  {
    quote:
      'The brake actuator failed on my Gen 3 Prius, and everyone else told me to junk it. Tip Top Hybrid sourced the part and fixed it fast. I am back to 50 mpg.',
    name: 'Monica J.',
    city: 'Rancho Cucamonga, CA',
    service: 'Brake actuator replacement',
  },
  {
    quote:
      'My hybrid had a warning light that no one could figure out. Tip Top diagnosed it in one visit and had the cooling pump replaced within hours. I will never go anywhere else.',
    name: 'Steven L.',
    city: 'Rialto, CA',
    service: 'Inverter water pump',
  },
  {
    quote:
      'From the moment I called about my Prius battery, I felt like I was in good hands. The team explained all the options — OEM, refurbished, warranty terms — and did not push me to overspend.',
    name: 'Karen B.',
    city: 'Pomona, CA',
    service: 'Battery options',
  },
];
const url = 'https://www.tiptophybrid.com/testimonials/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'AutoRepair',
      '@id': 'https://www.tiptophybrid.com/#organization',
      name: 'Tip Top Hybrid',
      url: 'https://www.tiptophybrid.com/',
      telephone: '+1-909-238-7028',
      aggregateRating: { '@type': 'AggregateRating', ratingValue: '5', reviewCount: '8', bestRating: '5' },
      review: reviews.map((r) => ({
        '@type': 'Review',
        author: { '@type': 'Person', name: r.name },
        reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
        reviewBody: r.quote,
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tiptophybrid.com/' },
        { '@type': 'ListItem', position: 2, name: 'Customer reviews' },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="service-page">
  <nav class="mx-auto max-w-6xl px-5 pt-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-green-700" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-700">Reviews</li>
    </ol>
  </nav>

  <section class="mx-auto max-w-6xl px-5 py-10 lg:py-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-green-700">Customer reviews</p>
    <h1 class="max-w-4xl text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.8rem]">
      What hybrid owners say about Tip Top Hybrid
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-700">
      We work on hybrids every day, mostly on the problems other shops send away: hybrid packs, brake actuators,
      inverters and high-voltage faults. Here is what customers say after the repair, in their words.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
      <div>
        <div class="text-4xl font-extrabold text-slate-900">5.0</div>
        <div class="mt-1 text-amber-500" aria-hidden="true">★★★★★</div>
        <div class="mt-1 text-sm text-slate-500">Based on 8 Google reviews</div>
      </div>
      <div class="h-16 w-px bg-slate-200" aria-hidden="true"></div>
      <div class="max-w-md">
        <p class="text-sm leading-relaxed text-slate-600">
          Most customers mention the same three things: the diagnosis was explained clearly, the price matched the
          quote, and the car was fixed in the time promised.
        </p>
        <a
          href={SITE.social.google}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-block text-sm font-bold text-green-700 hover:text-green-800"
        >
          Read the reviews on Google →
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-14">
    <div class="grid gap-5 md:grid-cols-2">
      {reviews.map((r) => (
        <figure class="flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="mb-3 text-amber-500" aria-hidden="true">★★★★★</div>
          <blockquote class="flex-1 text-[1.02rem] leading-[1.75] text-slate-700">“{r.quote}”</blockquote>
          <figcaption class="mt-5 border-t border-slate-100 pt-4 text-sm">
            <strong class="text-slate-900">{r.name}</strong>
            <span class="text-slate-500"> · {r.city}</span>
            <span class="mt-1 block text-xs uppercase tracking-wide text-green-700">{r.service}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-5 py-14">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">What the reviews have in common</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['The diagnosis is explained', 'You hear what failed, what it affects and what happens if it waits.'],
          ['The price matches the quote', 'Written estimate before work. No surprise line items at pickup.'],
          ['The repair is finished when promised', 'Most battery and brake jobs are same-day or next-day.'],
          ['Repair before replacement', 'Modules, pumps and sensors get tested before a whole assembly is condemned.'],
        ].map(([t, b]) => (
          <div class="rounded-xl border border-slate-200 bg-slate-50/60 p-5">
            <h3 class="mb-2 font-bold text-slate-900">{t}</h3>
            <p class="text-sm leading-relaxed text-slate-600">{b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <div class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-7 shadow-sm md:grid-cols-[1.3fr_1fr] md:items-center">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900">Bought a hybrid and not sure where to start?</h2>
        <p class="mt-3 text-[1.02rem] leading-[1.8] text-slate-700">
          A pre-purchase inspection or a first-time battery health check tells you what you are buying. We test the
          pack, cooling and hybrid codes, then give you a written summary you can use in the negotiation.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 md:justify-end">
        <a href={telHref} class="rounded-lg bg-green-600 px-6 py-3 font-bold text-white hover:bg-green-700">Call {tel}</a>
        <a href="/free-estimate/" class="rounded-lg border border-slate-300 px-6 py-3 font-semibold text-slate-800 hover:border-green-600 hover:text-green-700">Free estimate</a>
      </div>
    </div>
  </section>

  <section class="bg-green-700">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Had work done with us?</h2>
        <p class="mt-2 max-w-2xl text-green-50">A short Google review helps the next hybrid owner find a shop that will test before replacing.</p>
      </div>
      <a href={SITE.social.google} target="_blank" rel="noopener" class="flex-none rounded-lg bg-white px-6 py-3 font-bold text-green-800">
        Leave a Google review
      </a>
    </div>
  </section>
</div>
