---
import ContactForm from './ContactForm';
import { SITE } from '../data/site';

const tel = SITE.phone;
const telHref = `tel:${SITE.phoneRaw}`;
const url = 'https://www.tiptophybrid.com/contact/';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ContactPage',
      '@id': url,
      url,
      name: 'Contact Tip Top Hybrid',
      description: 'Contact Tip Top Hybrid in Upland, CA for hybrid battery, inverter, brake actuator, transaxle and engine repair. Call 909-238-7028.',
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: [
        {
          '@type': 'Question',
          name: 'How do I book a hybrid repair at Tip Top Hybrid?',
          acceptedAnswer: { '@type': 'Answer', text: 'Call 909-238-7028 or send the contact form with your year, make, model and symptoms. We confirm the diagnostic fee, if any, before the car is worked on.' },
        },
        {
          '@type': 'Question',
          name: 'What should I include in the message?',
          acceptedAnswer: { '@type': 'Answer', text: 'Year, make and model, the warning lights or symptoms, when it happens, and whether the car is safe to drive. A photo of the dashboard helps.' },
        },
        {
          '@type': 'Question',
          name: 'Do you offer a free estimate?',
          acceptedAnswer: { '@type': 'Answer', text: 'Yes. Send the details through the form or call. If diagnosis is required, we quote that fee before starting.' },
        },
        {
          '@type': 'Question',
          name: 'Can the car be towed to the shop?',
          acceptedAnswer: { '@type': 'Answer', text: 'Yes. If the car will not start or is not safe to drive, call before arranging the tow so we can confirm the shop is ready for it.' },
        },
        {
          '@type': 'Question',
          name: 'Where are you located?',
          acceptedAnswer: { '@type': 'Answer', text: '1894 W 9th St Ste B, Upland, CA 91786, between the 10 and the 210. We serve Upland, Montclair, Claremont, Pomona, Rancho Cucamonga, Ontario, San Bernardino and Riverside.' },
        },
      ],
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tiptophybrid.com/' },
        { '@type': 'ListItem', position: 2, name: 'Contact' },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="service-page">
  <nav class="mx-auto max-w-6xl px-5 pt-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-green-700" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-700">Contact</li>
    </ol>
  </nav>

  <section class="mx-auto grid max-w-6xl gap-10 px-5 py-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start lg:py-14">
    <div>
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-green-700">Contact · Upland, CA</p>
      <h1 class="text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.7rem]">
        Contact Tip Top Hybrid
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-700">
        Call <a class="font-bold text-green-700" href={telHref}>{tel}</a> or send the form. Tell us the year, model
        and what the car is doing, and we will tell you what it likely needs and what it costs.
      </p>

      <div class="mt-7 space-y-4">
        <div class="flex gap-4 rounded-xl border border-slate-200 bg-white p-5">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-green-100 text-green-700"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 2z"/></svg></span>
          <div>
            <h2 class="font-bold text-slate-900">Call the shop</h2>
            <a class="text-green-700 hover:text-green-800" href={telHref}>{tel}</a>
            <p class="mt-1 text-sm text-slate-500">Fastest for warning lights, no-starts and towing questions.</p>
          </div>
        </div>
        <div class="flex gap-4 rounded-xl border border-slate-200 bg-white p-5">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-green-100 text-green-700"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          <div>
            <h2 class="font-bold text-slate-900">Visit the shop</h2>
            <p class="text-slate-600">1894 W 9th St Ste B, Upland, CA 91786</p>
            <p class="mt-1 text-sm text-slate-500">Between the 10 and the 210, a short drive from Claremont, Pomona and Rancho Cucamonga.</p>
          </div>
        </div>
        <div class="flex gap-4 rounded-xl border border-slate-200 bg-white p-5">
          <span class="flex h-10 w-10 flex-none items-center justify-center rounded-full bg-green-100 text-green-700"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
          <div>
            <h2 class="font-bold text-slate-900">Hours</h2>
            <p class="text-slate-600">Monday–Saturday, 9am–5pm</p>
            <p class="mt-1 text-sm text-slate-500">Sunday closed. Call ahead for same-day hybrid diagnostics.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-extrabold text-slate-900">Request a call back</h2>
      <p class="mt-1 text-sm text-slate-500">We reply during shop hours. No spam, no automated sales calls.</p>
      <div class="contact-form-wrap mt-5">
        <ContactForm formId={2} action="/contact/" />
      </div>
    </div>
  </section>

  <section class="border-y border-slate-100 bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">What to include in your message</h2>
        <ul class="mt-6 space-y-3">
          {[
            'Year, make and model — for example, 2012 Toyota Prius.',
            'The warning lights you see, and any codes you already have.',
            'When it happens: cold start, hot day, braking, accelerating or at highway speed.',
            'Whether the car is safe to drive or needs a tow.',
            'A photo of the dashboard if you can. It saves a phone call.',
          ].map((t) => (
            <li class="flex gap-3 text-[1.02rem] leading-relaxed text-slate-700">
              <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">✓</span>
              {t}
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Where we are</h2>
        <p class="mt-4 text-[1.02rem] leading-[1.8] text-slate-700">
          The shop is in Upland, just off the 10. Customers come from Montclair, Claremont, Pomona, Rancho Cucamonga,
          Ontario, Chino, San Bernardino, Riverside, Corona and across the Inland Empire.
        </p>
        <p class="mt-4 text-[1.02rem] leading-[1.8] text-slate-700">
          If the car will not start, call before you arrange a tow. We will confirm whether it is safe to move and
          whether the shop can take it that day.
        </p>
        <div class="mt-5 overflow-hidden rounded-xl border border-slate-200">
          <iframe
            src={SITE.mapIframeNoCard}
            title="Map showing Tip Top Hybrid in Upland, California"
            width="100%"
            height="260"
            loading="lazy"
            style="border:0;display:block"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-5 py-14">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Contact questions</h2>
    <div class="mt-7 divide-y divide-slate-200">
      {[
        ['How soon will I hear back?', 'During shop hours, usually within a couple of hours. If you need an answer now, call 909-238-7028.'],
        ['Do you charge for an estimate?', 'The estimate is free. If the car needs diagnostic time, we confirm that fee before starting.'],
        ['Can I drop the car off before opening?', 'Call first. We will tell you where to leave the keys and when the car will be looked at.'],
        ['Do you work on hybrids other than Toyota?', 'Yes. Toyota and Lexus are our specialty, and we also service Honda, Ford and other hybrid models.'],
        ['What if the car is not safe to drive?', 'Call before moving it. We will tell you whether to tow it or whether it can be driven a short distance.'],
      ].map(([q, a]) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-slate-900">
            <span>{q}</span>
            <span class="mt-1 flex-none text-green-600 transition group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[1.02rem] leading-[1.8] text-slate-600">{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="bg-green-700">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Need an answer now?</h2>
        <p class="mt-2 max-w-2xl text-green-50">Call the shop and describe the symptom. We will tell you what it likely is and whether it can wait.</p>
      </div>
      <a href={telHref} class="flex-none rounded-lg bg-white px-6 py-3 font-bold text-green-800">Call {tel}</a>
    </div>
  </section>
</div>
