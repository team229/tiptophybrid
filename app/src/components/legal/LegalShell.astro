---
import { SITE } from '../../data/site';

interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<main class="bg-[#f3f7f9] py-12 sm:py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs text-[#6b7280]">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-2" aria-hidden="true">/</span>
      <span class="text-[#272727]">{title}</span>
    </nav>

    <article class="boxshadow bg-white p-6 sm:p-10">
      <h1 class="text-3xl font-bold text-[#272727] sm:text-4xl">{title}</h1>
      <p class="mt-2 text-sm text-[#6b7280]">Last updated: {updated}</p>
      <p class="mt-4 text-sm text-[#6b7280]">
        {SITE.name} · {SITE.street}, Upland, CA 91786 · {SITE.phone} ·
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>

      <div class="legal-body mt-6 text-[15px] leading-relaxed text-[#4b5563]">
        <slot />
      </div>
    </article>
  </div>
</main>

<style is:global>
  .legal-body h2 {
    margin: 1.9em 0 0.6em;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: #272727;
  }
  .legal-body h2:first-child {
    margin-top: 0;
  }
  .legal-body p {
    margin: 0 0 1em;
  }
  .legal-body ul {
    margin: 0 0 1.25em 1.15em;
    padding-left: 0.9em;
    list-style: disc;
  }
  .legal-body li {
    margin-bottom: 0.45em;
  }
  .legal-body a {
    color: #2f9e3f;
    text-decoration: underline;
  }
  .legal-body strong {
    color: #272727;
  }
</style>
