---
import { SITE, SERVICES } from '../data/site';

const tel = SITE.phone;
const telHref = `tel:${SITE.phoneRaw}`;


const cards = [
  {
    title: 'Hybrid Battery Repair & Replacement',
    href: '/toyota-prius-battery-repair-replacement/',
    body: 'Testing, module repair, reconditioning and replacement for Prius, Camry, RAV4, Lexus and Honda hybrids. We test before quoting a pack.',
    tag: 'Most requested',
  },
  {
    title: 'High-Voltage System Repair',
    href: '/high-voltage-system-repair/',
    body: 'Isolation faults, orange cable damage, service-plug and inverter faults. Shop-only work with the right safety equipment.',
    tag: 'Safety-critical',
  },
  {
    title: 'Inverter & Brake Actuator Repair',
    href: '/inverter-brake-actuator-repair/',
    body: 'ABS, BRAKE and VSC lights, C1256, C1310, C1391, P0A93 and P0A94. We test the actuator and inverter before replacing them.',
    tag: 'Codes diagnosed',
  },
  {
    title: 'Inverter Water Pump Service',
    href: '/inverter-water-pump-service/',
    body: 'Coolant flow, pump command and leak testing. A $350–$700 pump today prevents a four-figure inverter later.',
    tag: 'Preventive',
  },
  {
    title: 'Hybrid Transaxle & Drivetrain',
    href: '/hybrid-transaxle-drivetrain-service/',
    body: 'Whine, shudder, leaks and no-move faults. Fluid service, used units and rebuilt transaxles with warranty.',
    tag: 'Drivetrain',
  },
  {
    title: 'Engine & Transmission Replacement',
    href: '/hybrid-engine-transmission-replacement/',
    body: 'Head gasket, coolant loss, knocking and no-start. Pressure and combustion-gas testing before we quote an engine.',
    tag: 'Major repair',
  },
];

const faqs = [
  {
    q: 'What does hybrid car repair cost in Upland?',
    a: 'It depends on the system. A diagnostic is typically $100–$300. A 12V battery is $180–$320 installed. A brake actuator is $1,200–$2,600. A reconditioned hybrid pack is $1,500–$2,600. We quote in writing before work starts.',
  },
  {
    q: 'Do you only work on Toyota and Lexus hybrids?',
    a: 'Toyota and Lexus are our specialty, but we also service Honda Accord and Civic hybrids, Ford Fusion and Escape hybrids, and other hybrid models. Tell us the year, make and model when you book.',
  },
  {
    q: 'Can a general mechanic work on my hybrid?',
    a: 'Some routine work, yes. High-voltage systems, inverters, brake actuators and hybrid battery diagnostics need hybrid-specific training, tools and safety procedures. A general shop often sends these jobs to a specialist.',
  },
  {
    q: 'Do you offer a free estimate?',
    a: 'Yes. You can request an estimate online or call with the year, model and symptoms. If the car needs diagnostic time, we confirm that fee before starting.',
  },
  {
    q: 'Where are you located and who do you serve?',
    a: 'We are at 1894 W 9th St Ste B in Upland, CA. Customers come from Upland, Montclair, Claremont, Pomona, Rancho Cucamonga, Ontario, San Bernardino, Riverside and across the Inland Empire.',
  },
  {
    q: 'Is there a warranty on repairs?',
    a: 'Yes. Warranty terms depend on the part and the repair. The term is written on your estimate before work begins.',
  },
];
const url = 'https://www.tiptophybrid.com/upland-auto-body-car-repair-shop-services/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': url,
      name: 'Hybrid Car Repair in Upland, CA',
      description: 'Hybrid battery, high-voltage, inverter, brake actuator, transaxle and engine services in Upland, California.',
      url,
    },
    {
      '@type': 'ItemList',
      '@id': `${url}#services`,
      itemListElement: cards.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.title,
        url: `https://www.tiptophybrid.com${c.href}`,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${url}#faq`,
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${url}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.tiptophybrid.com/' },
        { '@type': 'ListItem', position: 2, name: 'Services' },
      ],
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<div class="service-page">
  <nav class="mx-auto max-w-6xl px-5 pt-6 text-sm text-slate-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-2">
      <li><a class="hover:text-green-700" href="/">Home</a></li>
      <li aria-hidden="true">/</li>
      <li class="text-slate-700">Services</li>
    </ol>
  </nav>

  <section class="mx-auto max-w-6xl px-5 py-10 lg:py-14">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.14em] text-green-700">Hybrid specialists · Upland, CA</p>
    <h1 class="max-w-4xl text-3xl font-extrabold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.8rem]">
      Hybrid Car Repair in Upland, CA
    </h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-slate-700">
      We are a hybrid-only repair shop, not a general garage that occasionally sees a Prius. Battery diagnostics,
      high-voltage systems, inverters, brake actuators, transaxles and engine work — diagnosed with hybrid-specific
      tools and quoted in writing before we start.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href={telHref} class="rounded-lg bg-green-600 px-6 py-3 font-bold text-white shadow-sm transition hover:bg-green-700">Call {tel}</a>
      <a href="/free-estimate/" class="rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-800 transition hover:border-green-600 hover:text-green-700">Get a free estimate</a>
    </div>
    <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600">
      <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Hybrid-specific diagnostics</li>
      <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Written quote first</li>
      <li class="flex items-center gap-2"><span class="text-green-600">✓</span> Inland Empire service area</li>
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 pb-14">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {cards.map((c) => (
        <a href={c.href} class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-green-500 hover:shadow-md">
          <span class="mb-3 inline-flex w-fit rounded-full bg-green-50 px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-wide text-green-700">{c.tag}</span>
          <h2 class="text-lg font-extrabold leading-snug text-slate-900 group-hover:text-green-800">{c.title}</h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{c.body}</p>
          <span class="mt-4 text-sm font-bold text-green-700">View service →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-2">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Not sure what is wrong?</h2>
        <p class="mt-4 text-[1.04rem] leading-[1.8] text-slate-700">
          A warning light is a symptom, not a diagnosis. We start with a scan, live data and a road test, then test the
          system the code points at. You get the findings and a written quote before any parts are ordered.
        </p>
        <p class="mt-4 text-[1.04rem] leading-[1.8] text-slate-700">
          That order matters. A weak 12V battery can look like a failed hybrid pack. A failing water pump can look like
          a failed inverter. A wheel-speed sensor can look like a brake actuator. Testing first is how you avoid paying
          for a part you did not need.
        </p>
        <a href="/free-estimate/" class="mt-6 inline-block rounded-lg bg-green-600 px-6 py-3 font-bold text-white transition hover:bg-green-700">Book a diagnostic</a>
      </div>
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Why a hybrid specialist</h2>
        <ul class="mt-5 space-y-4">
          {[
            ['Hybrid-specific tools', 'Factory-level scan data, block-voltage testing and high-voltage safety equipment.'],
            ['Experience with the common failures', 'P0A80 packs, brake actuator codes, inverter pumps and Gen 3 head gaskets.'],
            ['Independent pricing', 'Dealer-level capability without dealer parts and labor pricing.'],
            ['Straight answers', 'If the car does not need the repair, we say so. The quote is in writing.'],
          ].map(([t, b]) => (
            <li class="flex gap-3">
              <span class="mt-1 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-green-100 text-xs font-bold text-green-700">✓</span>
              <div>
                <strong class="text-slate-900">{t}.</strong> <span class="text-slate-600">{b}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-14">
    <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Serving Upland and the Inland Empire</h2>
    <p class="mt-4 max-w-3xl text-[1.04rem] leading-[1.8] text-slate-700">
      Our shop is at 1894 W 9th St Ste B in Upland, minutes from the 10 and the 210. Customers drive to us from
      Montclair, Claremont, Pomona, Rancho Cucamonga, Ontario, Chino, San Bernardino, Riverside, Corona and across
      the Inland Empire. If your hybrid will not start, call before you arrange a tow and we will tell you whether it
      is safe to move.
    </p>
  </section>

  <section class="border-t border-slate-100 bg-white">
    <div class="mx-auto max-w-3xl px-5 py-14">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">Frequently asked questions</h2>
      <div class="mt-7 divide-y divide-slate-200">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-semibold text-slate-900">
              <span>{f.q}</span>
              <span class="mt-1 flex-none text-green-600 transition group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 text-[1.02rem] leading-[1.8] text-slate-600">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-green-700">
    <div class="mx-auto flex max-w-5xl flex-col items-start gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 class="text-2xl font-extrabold tracking-tight text-white sm:text-3xl">Tell us what the car is doing</h2>
        <p class="mt-2 max-w-2xl text-green-50">Year, model and the symptom is enough to start. We will tell you what it likely needs and what it costs.</p>
      </div>
      <div class="flex flex-none flex-wrap gap-3">
        <a href={telHref} class="rounded-lg bg-white px-6 py-3 font-bold text-green-800">Call {tel}</a>
        <a href="/free-estimate/" class="rounded-lg border border-white/60 px-6 py-3 font-semibold text-white hover:bg-white/10">Free estimate</a>
      </div>
    </div>
  </section>
</div>
