---
import '../styles/global.css';
import Header from '../components/Header';
import LandingHeader from '../components/landing/LandingHeader';
import LandingFooter from '../components/landing/LandingFooter.astro';
import MobileCtaBar from '../components/landing/MobileCtaBar.astro';
import Footer from '../components/Footer';
import LeadForm from '../components/LeadForm.astro';
import headParts from '../data/head-parts.json';
import { ASSET_BASE, withAssetBase } from '../data/content';
import type { PageData } from '../data/pages';

interface Props {
  page: PageData;
  /**
   * `site`    — the original WordPress header/navigation.
   * `landing` — the slim ads header (logo + Free Estimate only) and a matching
   *             body offset, used by /repair/.
   */
  variant?: 'site' | 'landing';
  /** Hero/LCP image to fetch early (landing pages only). */
  preloadImage?: string;
}

const { page, variant = 'site', preloadImage } = Astro.props;
const isLanding = variant === 'landing';

/**
 * The WordPress runtime the captured markup needs. The landing page answers the
 * contact form itself, so the Gravity Forms and Elementor runtimes, the emoji
 * loader and comment-reply are dropped there (~230 KB less JavaScript to parse).
 */
const wpRuntime = [
  '/wp-content/themes/pro/cornerstone/assets/js/site/cs-classic.7.6.6.js',
  '/wp-content/themes/pro/framework/dist/js/site/x.js',
  '/wp-includes/js/comment-reply.min.js',
  '/wp-content/plugins/elementor/assets/js/webpack.runtime.min.js',
  '/wp-content/plugins/elementor/assets/js/frontend-modules.min.js',
  '/wp-content/plugins/elementor/assets/js/frontend.min.js',
  '/wp-includes/js/jquery/ui/core.min.js',
  '/wp-content/themes/pro/cornerstone/assets/js/site/cs-sliders.7.6.6.js',
  '/wp-includes/js/dist/dom-ready.min.js',
  '/wp-includes/js/dist/hooks.min.js',
  '/wp-includes/js/dist/i18n.min.js',
  '/wp-includes/js/dist/a11y.min.js',
  '/wp-content/plugins/gravityforms/js/gravityforms.min.js',
  '/wp-content/plugins/gravityforms/js/jquery.json.min.js',
  '/wp-content/plugins/gravityforms/js/jquery.maskedinput.min.js',
  '/wp-content/plugins/gravityforms/assets/js/dist/utils.min.js',
  '/wp-content/plugins/gravityforms/assets/js/dist/vendor-theme.min.js',
  '/wp-content/plugins/gravityforms/assets/js/dist/scripts-theme.min.js',
  '/wp-content/themes/pro/cornerstone/assets/js/site/cs-accordion.7.6.6.js',
  '/wp-content/themes/pro/cornerstone/assets/js/site/cs-google-maps.7.6.6.js',
  '/wp-includes/js/wp-emoji-loader.min.js',
  '/wp-includes/js/wp-emoji-release.min.js',
];
const landingSkipRuntime = /(gravityforms|wp-emoji|comment-reply|elementor)/;
const runtimeScripts = isLanding
  ? wpRuntime.filter((src) => !landingSkipRuntime.test(src))
  : wpRuntime;
const { seo, jsonldRaw, bodyClass } = page;
const S = headParts.snippets;

/**
 * The original page loads the shared Elementor / theme / Gravity Forms stylesheets
 * from its own origin. They are kept verbatim so the rendering is identical.
 */
const sharedStylesheets = headParts.stylesheets
  .filter((s) => s.href.includes('tiptophybrid.com'))
  .map((s) => withAssetBase(s.href));

const fontLinks = headParts.fontLinks.map((l) => withAssetBase(l));
---

<!doctype html>
<html lang="en-US" class="js" style="--x-body-scroll-bar-size: 0px; --x-body-scroll-active-bar-size: 0px;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>

    {seo.robots && <meta name="robots" content={seo.robots} />}
    {seo.description && <meta name="description" content={seo.description} />}

    {seo.ogLocale && <meta property="og:locale" content={seo.ogLocale} />}
    {seo.ogType && <meta property="og:type" content={seo.ogType} />}
    {seo.ogTitle && <meta property="og:title" content={seo.ogTitle} />}
    {seo.ogDescription && <meta property="og:description" content={seo.ogDescription} />}
    {seo.ogUrl && <meta property="og:url" content={seo.ogUrl} />}
    {seo.ogSiteName && <meta property="og:site_name" content={seo.ogSiteName} />}
    {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
    {seo.modified && <meta property="article:modified_time" content={seo.modified} />}
    {seo.published && <meta property="article:published_time" content={seo.published} />}

    {seo.twitterCard && <meta name="twitter:card" content={seo.twitterCard} />}
    {seo.twitterTitle && <meta name="twitter:title" content={seo.twitterTitle} />}
    {seo.twitterDescription && <meta name="twitter:description" content={seo.twitterDescription} />}
    {seo.twitterImage && <meta name="twitter:image" content={seo.twitterImage} />}

    {seo.generator && <meta name="generator" content={seo.generator} />}
    {seo.tileImage && <meta name="msapplication-TileImage" content={seo.tileImage} />}

    {seo.canonical && <link rel="canonical" href={seo.canonical} />}
    {seo.next && <link rel="next" href={seo.next} />}
    {seo.prev && <link rel="prev" href={seo.prev} />}

    <link rel="profile" href="https://gmpg.org/xfn/11" />
    <link rel="pingback" href="https://www.tiptophybrid.com/xmlrpc.php" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tip Top Auto Electric » Feed"
      href="https://www.tiptophybrid.com/feed/"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Tip Top Auto Electric » Comments Feed"
      href="https://www.tiptophybrid.com/comments/feed/"
    />
    <link rel="icon" href="https://www.tiptophybrid.com/wp-content/uploads/2020/01/cropped-Auto-Electric-Black-1-32x32.png" sizes="32x32" />
    <link rel="icon" href="https://www.tiptophybrid.com/wp-content/uploads/2020/01/cropped-Auto-Electric-Black-1-192x192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="https://www.tiptophybrid.com/wp-content/uploads/2020/01/cropped-Auto-Electric-Black-1-180x180.png" />

    <!-- Structured data (Yoast + the site's own schema blocks), byte-identical. -->
    {jsonldRaw.map((block) => <script type="application/ld+json" set:html={block} />)}

    <!-- Tracking: call tracking, Microsoft Clarity, Google Tag Manager, GA4, Google Ads. -->
    {S.callTracking && <Fragment set:html={S.callTracking} />}
    {S.clarityLoader && <Fragment set:html={S.clarityLoader} />}
    {S.clarityTag && <Fragment set:html={S.clarityTag} />}
    {S.clarityTagGtm && <Fragment set:html={S.clarityTagGtm} />}
    {S.gtmAsync && <Fragment set:html={S.gtmAsync} />}
    {S.gtmInline && <Fragment set:html={S.gtmInline} />}
    {S.ga4Loader && <Fragment set:html={S.ga4Loader} />}
    {S.ga4Inline && <Fragment set:html={S.ga4Inline} />}
    {S.adsLoader && <Fragment set:html={S.adsLoader} />}
    {S.adsInline && <Fragment set:html={S.adsInline} />}
    {S.wcmLoader && <Fragment set:html={S.wcmLoader} />}

    <!-- Gravity Forms runtime + jQuery, loaded in the head exactly like the original
         so the inline `gform.initializeOnLoaded()` calls further down the page work. -->
    {S.gform && <Fragment set:html={S.gform} />}
    <script
      src={withAssetBase('https://www.tiptophybrid.com/wp-includes/js/jquery/jquery.min.js?ver=3.7.1')}
      is:inline
    ></script>
    <script
      src={withAssetBase('https://www.tiptophybrid.com/wp-includes/js/jquery/jquery-migrate.min.js?ver=3.4.1')}
      is:inline
    ></script>
    {S.jqueryAfter && <Fragment set:html={S.jqueryAfter} />}

    {
      isLanding && (
        <>
          <link rel="preconnect" href="https://api-inform.bythub.in" crossorigin />
          {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
        </>
      )
    }

    {sharedStylesheets.map((href) => <link rel="stylesheet" href={href} media="all" />)}

    {
      isLanding && (
        <style is:global>
          /* The WordPress stylesheet fixes every <header> and reserves room with
             `body { padding-top }`. On the landing page the wrapper sticks
             instead, so the header never leaves a gap or covers the content. */
          body.landing-page {
            padding-top: 0;
          }
          /* `overflow-x: hidden` on html/body turns them into scroll containers,
             which disables sticky. `clip` still hides the slider overhang. */
          html,
          body.landing-page {
            overflow-x: clip;
          }
          body.landing-page #masthead {
            position: sticky;
            top: 0;
            z-index: 9999;
            width: 100%;
          }
          body.landing-page #masthead #main-header {
            position: static;
          }
          html {
            scroll-behavior: smooth;
          }
          body.landing-page #contact {
            scroll-margin-top: 84px;
          }
          @media (min-width: 1024px) {
            body.landing-page #contact {
              scroll-margin-top: 100px;
            }
          }
          /* Room for the mobile call / estimate bar. */
          @media (max-width: 767px) {
            body.landing-page {
              padding-bottom: 4.5rem;
            }
          }
          /* The captured hero reserves 12em of air above the headline. */
          body.landing-page .landing-hero.x-section {
            padding-top: 6em;
            padding-bottom: 6em;
          }
          @media (max-width: 766px) {
            body.landing-page .landing-hero.x-section {
              padding-top: 3.5em;
              padding-bottom: 3.5em;
            }
            body.landing-page .landing-hero h1 {
              font-size: 2rem;
              line-height: 1.15;
            }
          }
        </style>
      )
    }

    <!-- Webfonts are served from the mirrored copy so the page renders without
         waiting on fonts.googleapis.com. -->
    <link rel="stylesheet" href="/wp-content/fonts/roboto.css" media="all" />
    <link rel="stylesheet" href="/wp-content/fonts/robotoslab.css" media="all" />
    <link rel="stylesheet" href="/wp-content/fonts/poppinsfira.css" type="text/css" media="all" crossorigin="anonymous" data-x-google-fonts="" />
    <link rel="stylesheet" href="/wp-content/fonts/poppins.css" media="all" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>

  <body
    class={isLanding ? `${bodyClass} landing-page` : bodyClass}
    data-rsssl="1"
    data-elementor-device-mode="desktop"
  >
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KF7BFWB9"
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->

    <div id="page" class="hfeed site">
      <header id="masthead" itemscope itemtype="https://schema.org/WPHeader">
        <p class="main-title bhf-hidden">
          <a href="https://www.tiptophybrid.com/" title="Tip Top Auto Electric" rel="home">Tip Top Auto Electric</a>
        </p>
        {isLanding ? <LandingHeader /> : <Header current={page.slug} client:load />}
      </header>

      <slot />

      {isLanding ? <LandingFooter /> : <Footer client:idle />}
      {isLanding && <MobileCtaBar />}
    </div>

    <!-- Theme / Elementor runtime — the original loads these at the end of the body. -->
    {runtimeScripts.map((src) => <script src={src} is:inline></script>)}

    {
      !isLanding && (
        /* Lucide icon set (replaces the unpkg CDN script used by the original).
           The landing page only uses inline SVG, so it skips the 550 KB bundle. */
        <script src="/vendor/lucide/lucide.js" is:inline></script>
      )
    }

    <!-- Lead routing for every Gravity Forms form on the site. -->
    <LeadForm />

    <span id="elementor-device-mode" class="elementor-screen-only"></span>
    <p
      id="a11y-speak-intro-text"
      class="a11y-speak-intro-text"
      style="position:absolute;margin:-1px;padding:0;height:1px;width:1px;overflow:hidden;clip-path:inset(50%);border:0;word-wrap:normal !important;word-break:normal !important;"
      hidden
    >
      Notifications
    </p>
    <div
      id="a11y-speak-assertive"
      class="a11y-speak-region"
      style="position:absolute;margin:-1px;padding:0;height:1px;width:1px;overflow:hidden;clip-path:inset(50%);border:0;word-wrap:normal !important;word-break:normal !important;"
      aria-live="assertive"
      aria-relevant="additions text"
      aria-atomic="true"
    >
    </div>
    <div
      id="a11y-speak-polite"
      class="a11y-speak-region"
      style="position:absolute;margin:-1px;padding:0;height:1px;width:1px;overflow:hidden;clip-path:inset(50%);border:0;word-wrap:normal !important;word-break:normal !important;"
      aria-live="polite"
      aria-relevant="additions text"
      aria-atomic="true"
    >
    </div>
  </body>
</html>
