# Bunny Storage native HTTP API (site: tiptophybrid, Frankfurt)
# Docs: https://storage.bunnycdn.com / Bunny Storage API Reference

BUNNY_STORAGE_ZONE=tiptiphybrid
BUNNY_STORAGE_PASSWORD=<zone password from Bunny dashboard -> Storage -> FTP & API Access>
BUNNY_STORAGE_ENDPOINT=storage.bunnycdn.com

# Per-site CDN pull zone (matches .repos.json deploy.cdnPullZoneId)
BUNNY_PULL_ZONE_ID=6843566

# Shared account-level key — same for all sites, set in shell or websites/.env
# BUNNY_API_KEY=<account API key from Bunny dashboard -> Account -> API>
